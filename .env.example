# 模型配置
OPENAI_MODEL_BASE_URL=your_openai_model_base_url
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=model_name

# 搜索引擎配置
SEARCH_ENGINE_BASE_URL=your_search_engine_base_url
SEARCH_ENGINE_API_KEY=your_search_engine_api_key

# 语音识别配置
VOICE_RECOGNITION_API_URL=your_voice_recognition_api_url
VOICE_RECOGNITION_API_KEY=your_voice_recognition_api_key
# 语音识别音频参数
VOICE_AUDIO_FORMAT=paInt16
VOICE_AUDIO_CHANNELS=1
VOICE_AUDIO_RATE=16000
VOICE_AUDIO_CHUNK=1024
VOICE_RECORD_SECONDS=10
VOICE_SILENCE_THRESHOLD=500
VOICE_SILENCE_DURATION=2.0

# 语音合成配置
TTS_API_URL=your_tts_api_url
TTS_API_KEY=your_tts_api_key
TTS_FORMAT=mp3-16k
TTS_LANG=zh
TTS_SPEED=5
TTS_PITCH=5
TTS_VOLUME=5
TTS_ENABLE_SUBTITLE=0
TTS_OUTPUT_DIR=./audio_output

# MySQL数据库配置
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_DB=chatbot
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
DATABASE_URL=mysql+pymysql://root:your_mysql_password@your_mysql_host:3306/chatbot?charset=utf8mb4

# 权限信息数据库配置
PERMISSION_DB_HOST=your_permission_db_host
PERMISSION_DB_PORT=3306
PERMISSION_DB_NAME=personal_information
PERMISSION_DB_USER=root
PERMISSION_DB_PASSWORD=your_permission_db_password
PERMISSION_DB_URL=mysql+pymysql://root:your_permission_db_password@your_permission_db_host:3306/personal_information?charset=utf8mb4



# Redis数据库配置
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# PostgreSQL数据库配置
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@your_postgres_host:5432/postgres?charset=utf8mb4


# 日志级别
LOG_LEVEL=INFO

# Qdrant向量数据库配置
QDRANT_URL=http://your_qdrant_host:6333
QDRANT_HOST=your_qdrant_host
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=knowledge_base
EMBEDDING_MODEL=text-embedding-ada-002

