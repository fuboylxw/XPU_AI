# XPU AI Assistant 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# =============================================================================
# 基础配置
# =============================================================================

# 运行环境: development, testing, staging, production
ENVIRONMENT=development

# 应用调试模式
DEBUG=false

# =============================================================================
# API服务配置
# =============================================================================

# API服务地址和端口
API__HOST=202.200.206.248
API__PORT=8000
API__WORKERS=1

# API调试和重载
API__DEBUG=false
API__RELOAD=false

# CORS配置
API__CORS_ORIGINS=["*"]
API__CORS_CREDENTIALS=true

# 请求限制
API__MAX_REQUEST_SIZE=16777216
API__REQUEST_TIMEOUT=30

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库类型: sqlite, postgresql, mysql
DATABASE__TYPE=sqlite
DATABASE__HOST=202.200.206.248
DATABASE__PORT=5432
DATABASE__DATABASE=xpu_ai.db
DATABASE__USERNAME=
DATABASE__PASSWORD=
DATABASE__POOL_SIZE=10
DATABASE__ECHO=false

# =============================================================================
# Redis配置
# =============================================================================

REDIS__HOST=202.200.206.248
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=
REDIS__MAX_CONNECTIONS=10

# =============================================================================
# 安全配置
# =============================================================================

# JWT密钥 (生产环境必须设置，至少32位)
SECURITY__SECRET_KEY=your-secret-key-change-in-production-min-32-chars
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=7

# API密钥配置
SECURITY__API_KEY_HEADER=X-API-Key
SECURITY__API_KEYS=[]

# 限流配置
SECURITY__RATE_LIMIT_PER_MINUTE=60
SECURITY__RATE_LIMIT_PER_HOUR=1000
SECURITY__BURST_LIMIT=10

# IP白名单/黑名单
SECURITY__WHITELIST_IPS=[]
SECURITY__BLACKLIST_IPS=[]

# CSRF保护
SECURITY__CSRF_ENABLED=true
SECURITY__CSRF_TOKEN_LIFETIME_HOURS=1

# =============================================================================
# 日志配置
# =============================================================================

LOGGING__LEVEL=INFO
LOGGING__FILE_ENABLED=true
LOGGING__FILE_PATH=logs/app.log
LOGGING__FILE_MAX_SIZE=10MB
LOGGING__FILE_BACKUP_COUNT=5
LOGGING__CONSOLE_ENABLED=true

# =============================================================================
# AI服务配置
# =============================================================================

# DeepSeek API配置
AI__DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
AI__DEEPSEEK_API_BASE=https://api.deepseek.com/v1
AI__DEEPSEEK_MODEL=deepseek-chat
AI__DEEPSEEK_TEMPERATURE=0.7
AI__DEEPSEEK_MAX_TOKENS=2000

# 嵌入模型配置
AI__EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI__EMBEDDING_DEVICE=cpu

# RAG配置
AI__CHUNK_SIZE=1000
AI__CHUNK_OVERLAP=200
AI__TOP_K_RESULTS=5
AI__SIMILARITY_THRESHOLD=0.7

# =============================================================================
# 搜索引擎配置
# =============================================================================

# 搜索功能开关
SEARCH__ENABLED=true
SEARCH__TIMEOUT=30
SEARCH__MAX_RESULTS=5

# 百度AI搜索API配置
SEARCH__BAIDU_TOKEN=your-baidu-ai-search-token-here
SEARCH__BAIDU_URL=https://qianfan.baidubce.com/v2/ai_search/chat/completions

# Google搜索API配置
SEARCH__GOOGLE_API_KEY=your-google-api-key-here
SEARCH__GOOGLE_CSE_ID=your-google-custom-search-engine-id-here

# Bing搜索API配置
SEARCH__BING_API_KEY=your-bing-api-key-here

# 搜索引擎优先级
SEARCH__ENGINE_PRIORITY=["baidu", "google", "bing"]

# 搜索缓存配置
SEARCH__CACHE_ENABLED=true
SEARCH__CACHE_TTL=3600

# =============================================================================
# 文件处理配置
# =============================================================================

# 文件上传配置
FILE__UPLOAD_DIR=data/uploads
FILE__MAX_FILE_SIZE=10485760
FILE__ALLOWED_EXTENSIONS=["pdf", "docx", "txt", "xlsx", "pptx"]

# 文档处理目录
FILE__DOCUMENTS_DIR=data/documents
FILE__VECTOR_DB_DIR=data/vector_db

# =============================================================================
# MCP服务配置
# =============================================================================

# MCP服务开关
MCP__ENABLED=true
MCP__SERVER_NAME=school-info-server
MCP__SERVER_VERSION=1.0.0
MCP__SERVER_PORT=3000
MCP__TOOLS_ENABLED=true

# =============================================================================
# 兼容性配置 (保持向后兼容)
# =============================================================================

# 旧版本环境变量，新版本会自动映射
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
LOG_LEVEL=INFO
MCP_SERVER_PORT=3000
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=30
BAIDU_AI_SEARCH_TOKEN=your-baidu-ai-search-token-here
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-google-custom-search-engine-id-here
BING_API_KEY=your-bing-api-key-here
SERPAPI_KEY=your-serpapi-key-here